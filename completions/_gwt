#compdef gwt
# zsh completion for gwt. The candidates come from helpers defined in gwt.sh,
# so nothing is offered unless gwt.sh has been sourced.

local -a items
local expl ret=1

if (( CURRENT == 2 )); then
  items=(
    'init:create an empty workspace'
    'clone:clone a repo into a new workspace'
    'switch:cd to a worktree, creating it if needed'
    'add:create a worktree without changing directory'
    'remove:remove a worktree, keeping its branch'
    'help:show help'
    'list:list worktrees (git worktree list)'
    'lock:lock a worktree (git worktree lock)'
    'move:move a worktree (git worktree move)'
    'prune:prune stale worktree information (git worktree prune)'
    'repair:repair worktree administrative files (git worktree repair)'
    'unlock:unlock a worktree (git worktree unlock)'
  )
  _describe -t commands 'gwt command' items
  return
fi

case $words[2] in
  switch|add)
    # After -c come a new branch name and a start point: nothing to offer.
    (( CURRENT == 3 )) || return 1
    if [[ $words[CURRENT] == -* ]]; then
      items=('-c:create a new branch and its worktree')
      _describe -t options 'option' items
      return
    fi
    if [[ $words[2] == switch ]]; then
      items=(${(f)"$(_gwt_worktrees 2>/dev/null)"})
      _wanted worktrees expl 'worktree' compadd -a items && ret=0
    fi
    items=(${(f)"$(_gwt_branches 2>/dev/null)"})
    _wanted branches expl 'branch without a worktree' compadd -a items && ret=0
    return ret
    ;;
  remove)
    if [[ $words[CURRENT] == -* ]]; then
      items=(-f --force)
      _wanted options expl 'option' compadd -a items
      return
    fi
    items=(${(f)"$(_gwt_worktrees 2>/dev/null)"})
    _wanted worktrees expl 'worktree' compadd -a items
    ;;
  init)
    (( CURRENT == 3 )) && _directories
    ;;
  clone|help|-h|--help)
    return 1
    ;;
  *)
    # Pass-through subcommands complete as `git worktree <subcommand> ...`.
    words=(git worktree "${(@)words[2,-1]}")
    (( CURRENT++ ))
    _normal
    ;;
esac
